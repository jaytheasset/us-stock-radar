      }
    },
    {
      "name": "market-risk-sensitivity-table",
      "min_tables": 1,
      "table": {
        "classification": "data",
        "type_hints_include": ["market_risk_sensitivity"],
        "unit_hint_contains": "basis points",
        "cell_texts_include": ["100 basis points", "($2.0)", "-50 basis points", "$1.0"]
      }
    },
    {
      "name": "malformed-table-recovers-cells",
      "min_tables": 1,
      "table": {
        "cell_texts_include": ["Revenue", "100", "90", "Net income", "(5)", "4"],
        "warnings_include": ["table_extraction_recovered_malformed_table"]
      },
      "warnings_include": ["table_extraction_recovered_malformed_table"]
    }
