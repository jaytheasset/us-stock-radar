{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_ids",
    "kind",
    "status",
    "amount",
    "currency",
    "as_of_date",
    "as_of_text",
    "qualification",
    "basis",
    "evidence_blocks"
  ],
  "properties": {
    "component_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "enum": [
        "offering_limit",
        "remaining_offering_amount",
        "increase_amount",
        "decrease_amount"
      ]
    },
    "status": {
      "enum": [
        "current",
        "prior"
      ]
    },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_text": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "qualification": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "evidence_blocks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
