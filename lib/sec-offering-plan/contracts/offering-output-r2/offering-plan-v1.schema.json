{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offering Plan v1 — accession snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "filing",
    "status",
    "plan",
    "review"
  ],
  "properties": {
    "version": {
      "const": "offering_plan_v1"
    },
    "filing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "cik",
        "accession",
        "form",
        "filing_date",
        "accepted_at",
        "file_number",
        "registration_number"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "cik": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "accession": {
          "type": "string",
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
        },
        "form": {
          "enum": [
            "F-1",
            "F-1/A"
          ]
        },
        "filing_date": {
          "type": "string",
          "format": "date"
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "file_number": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "registration_number": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "REVIEW_REQUIRED",
        "NO_DIRECT_OFFERING_PLAN"
      ]
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "evidence_blocks",
            "candidates"
          ],
          "properties": {
            "code": {
              "enum": [
                "conflicting_quantity",
                "unclear_seller",
                "conflicting_price",
                "unclear_security_quantity",
                "other_core_conflict"
              ]
            },
            "evidence_blocks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/plan"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "null"
          },
          "plan": {
            "properties": {
              "components": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REVIEW_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object"
          },
          "plan": {
            "properties": {
              "components": {
                "maxItems": 0
              },
              "over_allotment": {
                "maxItems": 0
              },
              "post_offering_os": {
                "maxItems": 0
              },
              "proceeds": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_DIRECT_OFFERING_PLAN"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "null"
          },
          "plan": {
            "properties": {
              "components": {
                "maxItems": 0
              },
              "over_allotment": {
                "maxItems": 0
              },
              "post_offering_os": {
                "maxItems": 0
              },
              "proceeds": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "unit"
      ],
      "properties": {
        "status": {
          "enum": [
            "stated",
            "blank",
            "not_stated"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "stated"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "qualification",
        "value",
        "low",
        "high",
        "currency",
        "per_unit"
      ],
      "properties": {
        "status": {
          "enum": [
            "fixed",
            "range",
            "blank",
            "not_stated"
          ]
        },
        "qualification": {
          "enum": [
            "proposed",
            "assumed",
            "final_stated",
            "not_stated"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "low": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "high": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "per_unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "low": {
                "type": "null"
              },
              "high": {
                "type": "null"
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "per_unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "range"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "low": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "high": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "per_unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "blank",
                  "not_stated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "low": {
                "type": "null"
              },
              "high": {
                "type": "null"
              },
              "qualification": {
                "const": "not_stated"
              }
            }
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "seller_type",
        "security_type",
        "security_label",
        "quantity",
        "price",
        "scenario",
        "depositary",
        "evidence_blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "seller_type": {
          "enum": [
            "issuer",
            "selling_shareholders",
            "mixed",
            "unclear"
          ]
        },
        "security_type": {
          "enum": [
            "ordinary_shares",
            "common_stock",
            "preferred_shares",
            "ads",
            "adr",
            "depositary_security",
            "units",
            "warrants",
            "prefunded_warrants",
            "debt",
            "convertible_security",
            "other",
            "unclear"
          ]
        },
        "security_label": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "price": {
          "$ref": "#/$defs/price"
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "depositary": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "underlying_share_class",
                "underlying_shares_per_security",
                "evidence_blocks"
              ],
              "properties": {
                "underlying_share_class": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "underlying_shares_per_security": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_blocks": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "security_type": {
                "enum": [
                  "ads",
                  "adr",
                  "depositary_security"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "depositary": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "depositary": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "over": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_ids",
        "seller_type",
        "security_label",
        "quantity",
        "scenario",
        "evidence_blocks"
      ],
      "properties": {
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "seller_type": {
          "enum": [
            "issuer",
            "selling_shareholders",
            "mixed",
            "unclear"
          ]
        },
        "security_label": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_label",
        "quantity",
        "unit",
        "scenario",
        "evidence_blocks"
      ],
      "properties": {
        "security_label": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "evidence_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proceeds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "recipient",
        "amount",
        "currency",
        "scenario",
        "evidence_blocks"
      ],
      "properties": {
        "kind": {
          "enum": [
            "gross",
            "net",
            "no_proceeds"
          ]
        },
        "recipient": {
          "enum": [
            "issuer",
            "selling_shareholders",
            "mixed",
            "unclear"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "no_proceeds"
              }
            }
          },
          "then": {
            "properties": {
              "amount": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "currency": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "over_allotment",
        "post_offering_os",
        "proceeds"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "over_allotment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/over"
          }
        },
        "post_offering_os": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/post"
          }
        },
        "proceeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proceeds"
          }
        }
      }
    }
  }
}
