# Google AdSense (News V2)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_ANCHOR_ENABLED=true
NEXT_PUBLIC_ADSENSE_NEWS_V2_RAIL_300X250_SLOT_ID=
NEXT_PUBLIC_ADSENSE_NEWS_V2_RAIL_300X600_SLOT_ID=
NEXT_PUBLIC_ADSENSE_NEWS_V2_DESKTOP_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_NEWS_V2_MOBILE_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FILINGS_RAIL_300X250_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FILINGS_RAIL_300X600_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FILINGS_DESKTOP_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FILINGS_MOBILE_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_ANALYSIS_SIGNAL_COMPANION_SLOT_ID=
NEXT_PUBLIC_ADSENSE_ANALYSIS_COLLAPSED_RAIL_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FEED_RAIL_300X250_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FEED_DESKTOP_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FEED_MOBILE_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_DASHBOARD_V2_RAIL_SLOT_ID=
NEXT_PUBLIC_ADSENSE_DASHBOARD_V2_DESKTOP_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_DASHBOARD_V2_MOBILE_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_ALERTS_RAIL_300X250_SLOT_ID=
NEXT_PUBLIC_ADSENSE_ALERTS_RAIL_300X600_SLOT_ID=
NEXT_PUBLIC_ADSENSE_LIVE_ROOM_HEADER_728X90_SLOT_ID=
NEXT_PUBLIC_ADSENSE_LIVE_ROOM_RAIL_300X250_SLOT_ID=
NEXT_PUBLIC_ADSENSE_LIVE_ROOM_MOBILE_INLINE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_CALENDAR_RAIL_TOP_SLOT_ID=
NEXT_PUBLIC_ADSENSE_CALENDAR_RAIL_BOTTOM_SLOT_ID=
NEXT_PUBLIC_ADSENSE_CALENDAR_MOBILE_INLINE_SLOT_ID=

# Dashboard session-close mover finalizer
DASHBOARD_MOVERS_CRON_SECRET=

# Vercel Cron -> Workflow start authentication
# Use one random value of at least 16 characters in Vercel Production.
CRON_SECRET=
# Leave empty during the first deployment. Enable incrementally, for example:
# sec,news_fast,news_slow
SOURCE_INGEST_WORKFLOW_ENABLED_LANES=

# Workflow steps reuse the existing server-side ingest credentials.
# Never expose these as NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
APP_BASE_URL=http://127.0.0.1:3110
SEC_USER_AGENT=
OPENAI_API_KEY=
GEMINI_API_KEY=
NEWS_GEMINI_MODEL=gemini-2.5-flash-lite
FMP_API_KEY=
NAS_INGEST_TOKEN=
FDA_INGEST_URL=
ACCESSWIRE_INGEST_URL=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_SECRET_ENCRYPTION_KEY=
SNAPTRADE_CONNECTIONS_ENABLED=false
SNAPTRADE_PUBLIC_PROOFS_ENABLED=false
SNAPTRADE_MOCK_ENABLED=false
# Non-production only. Opens SnapTrade's credential-free funded SANDBOX broker.
SNAPTRADE_SANDBOX_BROKER=SANDBOX
SNAPTRADE_MANUAL_REFRESH_MONTHLY_LIMIT=20
SNAPTRADE_MANUAL_REFRESH_COOLDOWN_SECONDS=600
# Estimate only. Confirm the exact per-refresh charge in the SnapTrade dashboard.
SNAPTRADE_MANUAL_REFRESH_ESTIMATED_COST_CENTS=5

# Private prelaunch gate (server-only; never use NEXT_PUBLIC_*).
# The gate is disabled unless PRELAUNCH_MODE is exactly 1.
PRELAUNCH_MODE=0
PRELAUNCH_PASSWORD=
