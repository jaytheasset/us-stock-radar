{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "facts": {
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "expiration"
            ]
          },
          "current": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "wording": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "date",
              "wording"
            ],
            "additionalProperties": false
          },
          "previous": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "wording": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "date",
              "wording"
            ],
            "additionalProperties": false
          },
          "evidence_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tender:[a-f0-9]{64}$"
            }
          }
        },
        "required": [
          "type",
          "current",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "facts",
    "unresolved"
  ],
  "additionalProperties": false
}
